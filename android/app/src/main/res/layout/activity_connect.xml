<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/connect_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_marginTop="52dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/connect_subtitle"
            android:textColor="@color/accent_dim"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.3" />

        <!-- 连接卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/label_host" />

            <EditText
                android:id="@+id/input_host"
                style="@style/Input"
                android:hint="@string/host_hint"
                android:inputType="textNoSuggestions" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="16dp"
                android:text="@string/label_port" />

            <EditText
                android:id="@+id/input_port"
                style="@style/Input"
                android:hint="@string/port_hint"
                android:inputType="number" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="16dp"
                android:text="@string/label_password" />

            <EditText
                android:id="@+id/input_password"
                style="@style/Input"
                android:hint="@string/password_hint"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btn_connect"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/btn_primary"
                android:stateListAnimator="@null"
                android:text="@string/connect"
                android:textColor="@color/text_on_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <!-- 手势速查 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_soft"
            android:lineSpacingExtra="5dp"
            android:padding="16dp"
            android:text="@string/gesture_help"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="monospace"
            android:text="@string/footer"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            android:letterSpacing="0.05" />
    </LinearLayout>
</ScrollView>
